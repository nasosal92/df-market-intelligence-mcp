    "@x402/evm": "^2.28.0",
    "@x402/fetch": "^2.28.0",
    "viem": "^2.57.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nasosal92/df-market-intelligence-mcp.git"
