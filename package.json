    "README.md",
    "LICENSE"
  ],
  "mcpName": "io.github.nasosal92/df-market-intelligence-mcp",
  "scripts": {
    "build": "tsc && node scripts/postbuild.mjs",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "x402",
    "insider-trading",
    "sec",
